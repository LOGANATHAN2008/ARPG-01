# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=pg_uploads

# Razorpay (public key only — secret must NEVER go to frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Firebase (public config only)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# App config
VITE_APP_NAME="Bangalore Premium PG"
VITE_APP_URL=https://your-domain.com

# WhatsApp (used by frontend for manual share only)
VITE_PG_WHATSAPP_NUMBER=917022000000

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key

# ─────────────────────────────────────────────────────────────────
# SUPABASE EDGE FUNCTION SECRETS (set via: supabase secrets set)
# ─────────────────────────────────────────────────────────────────
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# WHATSAPP_API_TOKEN=your-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
